{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bottele",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-06-05",

  // ----------------------------------------------------------------------
  // D1 (SQLite) database — the single source of truth for all bot data
  // (products, orders, users, carts, states, broadcasts).
  //
  // Create it once with:
  //   npx wrangler d1 create shoptelgram
  // then paste the printed "database_id" below (replace REPLACE_WITH_YOUR_D1_ID)
  // and apply the schema:
  //   npm run d1:migrate        (remote)  |  npm run d1:migrate:local  (local dev)
  //
  // Migrations live in ./migrations and are applied with wrangler d1 migrations.
  // ----------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoptelgram",
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "migrations"
    }
  ],

  // ----------------------------------------------------------------------
  // LEGACY: KV namespace used by the previous version of the bot.
  // Only needed while running the one-time KV -> D1 data migration
  // (scripts/migrate-kv-to-d1.mjs). After migrating you can delete this
  // block and the namespace itself. New deployments don't need it.
  // ----------------------------------------------------------------------
  "kv_namespaces": [
    {
      "binding": "SHOP",
      "id": "REPLACE_WITH_YOUR_KV_ID"
    }
  ],

  // Non-secret configuration. Override per-environment as needed.
  // Secrets (BOT_TOKEN, WEBHOOK_SECRET, ADMIN_PANEL_PASSWORD) must NOT go here —
  // set them with
  //   npx wrangler secret put BOT_TOKEN
  //   npx wrangler secret put WEBHOOK_SECRET
  //   npx wrangler secret put ADMIN_PANEL_PASSWORD   (enables the web panel at /admin)
  // WEBHOOK_SECRET charset: Telegram allows only [A-Za-z0-9_-], max 256 chars
  // (e.g. generate with: openssl rand -hex 32).
  "vars": {
    "SHOP_NAME": "فروشگاه من",
    "ADMIN_IDS": "",
    "SUPPORT_CONTACT": ""
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
